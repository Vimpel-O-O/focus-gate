{
  "manifest_version": 3, "name": "Focus Gate", "version": "0.1.0",
  "description": "Check YouTube videos against your learning goals before playback.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "options.html",
  "action": {"default_title": "Focus Gate settings"},
  "content_scripts": [{
    "matches": ["https://*.youtube.com/*", "https://youtube.com/*", "https://*.youtube-nocookie.com/*"],
    "js": ["content.js"], "css": ["gate.css"], "run_at": "document_start", "all_frames": true
  }]
}
